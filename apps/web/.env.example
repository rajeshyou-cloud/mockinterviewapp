# Server-only database connection. Never prefix this with NEXT_PUBLIC_.
DATABASE_URL=

# Optional: point the web client to the standalone FastAPI service.
# Leave blank to use the self-contained Next.js API routes.
NEXT_PUBLIC_API_BASE_URL=

# Semantic scoring uses Vercel AI Gateway with deployment OIDC automatically.
# Use an API key for local semantic scoring; omit it to use the deterministic fallback.
AI_GATEWAY_API_KEY=
SCORING_MODEL=openai/gpt-5.6-luna
# Optional override: gateway | deterministic
SCORING_PROVIDER=

# Neon Managed Auth (server-only). The cookie secret must be at least 32 characters.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
