# Server-only database connection. Never prefix this with NEXT_PUBLIC_.
DATABASE_URL=

# Governed question reads: json (default), shadow (compare DB but serve JSON), or database.
# Database mode fails closed and exposes only published, evidence-verified records.
GOVERNED_CONTENT_SOURCE=json

# Optional: point the web client to the standalone FastAPI service.
# Leave blank to use the self-contained Next.js API routes.
NEXT_PUBLIC_API_BASE_URL=

# Semantic scoring uses Vercel AI Gateway with deployment OIDC automatically.
# Use an API key for local semantic scoring; omit it to use the deterministic fallback.
AI_GATEWAY_API_KEY=
SCORING_MODEL=openai/gpt-5.6-luna
# Optional override: gateway | deterministic
SCORING_PROVIDER=

# Optional governed benchmark-review automation (server/CLI only).
REVIEW_PROVIDER=openai-compatible
REVIEW_PRIMARY_MODEL=
REVIEW_CRITIC_MODEL=
REVIEW_OPENAI_COMPATIBLE_NAME=
REVIEW_OPENAI_COMPATIBLE_BASE_URL=
REVIEW_OPENAI_COMPATIBLE_API_KEY=
REVIEW_PRIMARY_INPUT_USD_PER_MILLION_TOKENS=0
REVIEW_PRIMARY_OUTPUT_USD_PER_MILLION_TOKENS=0
REVIEW_CRITIC_INPUT_USD_PER_MILLION_TOKENS=0
REVIEW_CRITIC_OUTPUT_USD_PER_MILLION_TOKENS=0

# Neon Managed Auth (server-only). The cookie secret must be at least 32 characters.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Stripe subscription billing (server-only except the public app URL).
NEXT_PUBLIC_APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CANDIDATE_PRICE_ID=
STRIPE_RECRUITER_PRICE_ID=
